# Copy to .env and fill in.

# Claude reads free-form messages and receipt/transfer photos.
# Without it, a simpler offline parser handles text only.
ANTHROPIC_API_KEY=

# WhatsApp group to listen to (exact name), or "self" for your own "Message yourself" chat.
WA_CHAT=Wedding Budget

# Dashboard port
PORT=3000

# Optional overrides
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# DATA_DIR=data
